# Reassembly inputs and machine-specific transfer metadata are redundant with
# the verified original dataset ZIPs, which are included in the repository.
/data/uploads/parts/
/data/uploads/downloads.json
/data/dataset_index_raw.json

# Keep superseded experiments and resumable inference caches local. Final
# dataset_audit_v2, posture_baseline_v2, image_research_final and reports are tracked.
/artifacts/dataset_audit/
/artifacts/image_baseline_v1/
/artifacts/image_baseline_v2/
/artifacts/posture_baseline_v1/
/artifacts/dataset_audit_v2/*.checkpoint.jsonl
/artifacts/dataset_audit_v2/extractor_*
/artifacts/hybrid_alternative_v1/*.checkpoint.jsonl

# New per-run training exports, snapshots, and private recordings stay local.
/runs/
/snapshots/
/demo-recordings/
